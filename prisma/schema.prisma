generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum RequestStatus {
  pending
  accepted
  rejected
}

model students {
  id String @id @default(uuid())
  name String
  parentName String
  age Int
  email String
  phone String
  program programs @relation(fields: [programId], references: [id])
  programId String
  notes String?
  adminNotes String?
  totalAmount Float?
  paidAmount Float?
  status RequestStatus @default(pending)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model programs {
  id String @id @default(uuid())
  name String
  description String
  students students[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model home_videos {
  id           String   @id @default(uuid())
  title        String
  youtubeId    String
  startSeconds Int?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model home_testimonials {
  id        String   @id @default(uuid())
  name      String
  role      String   @default("طالبة")
  imageUrl  String
  alt       String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}